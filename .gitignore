.pio

# ESP-IDF component manager: downloaded managed components, regenerated from
# src/idf_component.yml + dependencies.lock (which IS committed, like a
# lockfile). Never edit files under here by hand.
managed_components/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# PlatformIO/CMake/Ninja build artifacts — regenerated by `pio run`
build/

# macOS Finder metadata
.DS_Store

# Wi-Fi credentials — copy include/wifi_secrets.h.example to this path and
# fill in your own SSID/password. Never commit real credentials.
include/wifi_secrets.h

# Banyan Memory Bank — advisory cache (never sync between machines)
memory-bank/.local/

# Session logs + telemetry (generated, may contain sensitive info)
.agent-logs/sessions/
.agent-logs/claude/
.agent-logs/telemetry/
.agent-logs/telemetry.jsonl

# Claude Code command output logs (verification runs, etc.)
.claude-logs/
