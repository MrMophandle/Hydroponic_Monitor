menu "Hydroponic Monitor"

    comment "Pin assignments — GPIO 33-37 are routed to PSRAM on N16R8 modules and must not be used. GPIO 0/3/45/46 are strapping pins, 19/20 are USB-JTAG, and 26-32 are the SPI flash."

    menu "Ambient light (BH1750, I2C)"

        config HYDRO_I2C_SDA_GPIO
            int "I2C SDA GPIO"
            range 1 48
            default 8
            help
                GPIO wired to the HiLetgo GY-302 / BH1750 module's SDA pin.

        config HYDRO_I2C_SCL_GPIO
            int "I2C SCL GPIO"
            range 1 48
            default 9
            help
                GPIO wired to the HiLetgo GY-302 / BH1750 module's SCL pin.

    endmenu

    menu "Water temperature (DS18B20, 1-Wire)"

        config HYDRO_DS18B20_GPIO
            int "1-Wire data GPIO"
            range 1 48
            default 4
            help
                GPIO wired to the DROK waterproof DS18B20 probe's data line.
                A 4.7 kOhm pull-up to 3V3 is required on this line; whether the
                probe's own inline resistor is sufficient is a bench-verification
                item still open from the plan.

    endmenu

    menu "Water level (2 x float switch)"

        config HYDRO_LEVEL_HIGH_GPIO
            int "High-mark float switch GPIO"
            range 1 48
            default 5
            help
                GPIO wired to the float switch mounted at the high water mark.
                Configured as an input with the internal pull-up enabled, so the
                switch's other leg goes to ground.

        config HYDRO_LEVEL_LOW_GPIO
            int "Low-mark float switch GPIO"
            range 1 48
            default 6
            help
                GPIO wired to the float switch mounted at the low water mark.
                Configured as an input with the internal pull-up enabled, so the
                switch's other leg goes to ground.

        config HYDRO_LEVEL_INVERT_HIGH
            bool "Invert high-mark switch polarity"
            default n
            help
                Enable when a raw GPIO HIGH on the high-mark switch means "not
                floating" rather than "floating". The Piutouyar float switches are
                physically reversible, so this mapping depends on how the float is
                mounted and MUST be determined at the bench by raising and lowering
                the float — not assumed. Default n assumes the switch closes to
                ground (pulling the input LOW) when the float rises.

        config HYDRO_LEVEL_INVERT_LOW
            bool "Invert low-mark switch polarity"
            default n
            help
                As HYDRO_LEVEL_INVERT_HIGH, for the low-mark switch. Determine
                independently — the two switches can be mounted in opposite
                orientations.

    endmenu

    menu "Sampler"

        config HYDRO_SAMPLE_INTERVAL_SEC
            int "Sensor sampling interval (seconds)"
            range 5 3600
            default 30
            help
                How often the sampler task reads all three sensors and pushes
                one new entry into the ring buffer. The store's 2,880-entry
                capacity is sized for a 24-hour history window at the default
                30 s interval — changing this value changes how much
                wall-clock history the ring holds before it starts wrapping.

    endmenu

    menu "SNTP / Time"

        config HYDRO_SNTP_SERVER
            string "SNTP server hostname"
            default "pool.ntp.org"
            help
                NTP server queried by src/time_sync.c to synchronize
                wall-clock time. This device has no battery-backed RTC, so
                every reading's timestamp is unsynced (a 1970-anchored
                epoch, flagged invalid via READING_VALID_TIME_BIT) until
                this server is reachable over the configured Wi-Fi and the
                first sync completes.

        config HYDRO_SNTP_TZ
            string "POSIX TZ string for local time"
            default "UTC0"
            help
                POSIX TZ string passed to setenv("TZ", ...)/tzset() so
                localtime()/mktime()-based logic (a future day/night-
                scheduled pump relay) computes LOCAL time, not UTC.
                Day/night is inherently a local-time concept and DST shifts
                the boundary twice a year, so this is not optional polish.
                Example for US Eastern with DST: "EST5EDT,M3.2.0,M11.1.0".
                The default "UTC0" is a SAFE PLACEHOLDER, NOT this device's
                real deployment timezone — it must be changed via
                menuconfig to the actual local zone for correct local-time
                behavior; this file cannot know where the device is
                installed.

    endmenu

    menu "Status LED (onboard RGB)"

        config HYDRO_STATUS_LED_ENABLE
            bool "Enable the onboard status LED"
            default y
            help
                Drives the board's onboard WS2812 RGB LED to present the
                device's Wi-Fi/HTTP reachability state (green solid =
                healthy, red blink = degraded/booting, red solid = HTTP
                server permanently down). The GPIO this LED sits on rests
                on vendor Q&A, not a confirmed schematic (see
                HYDRO_STATUS_LED_GPIO below) — if the onboard LED turns out
                to be wired differently, absent, or the pin conflicts with
                another peripheral on a given board revision, disable this
                to skip RMT peripheral acquisition entirely rather than
                fail or drive the wrong pin.

        choice HYDRO_STATUS_LED_GPIO
            prompt "Onboard status LED GPIO"
            default HYDRO_STATUS_LED_GPIO_48
            depends on HYDRO_STATUS_LED_ENABLE
            help
                Which GPIO drives the onboard WS2812. GPIO 48 is Espressif's
                own vendor Q&A answer for this Hosyond ESP32-S3-WROOM-1
                module, but third-party documentation for boards in this
                family disagrees and cites 47 or 38 instead — this is a
                genuine, unresolved conflict (not a settled default), which
                is why this is a choice to pick from at build time rather
                than a plain int+range GPIO field like the sensor pins
                above, and why it must still be confirmed at the bench.

            config HYDRO_STATUS_LED_GPIO_48
                bool "GPIO 48 (Espressif vendor Q&A answer)"

            config HYDRO_STATUS_LED_GPIO_47
                bool "GPIO 47 (alternate per some third-party docs)"

            config HYDRO_STATUS_LED_GPIO_38
                bool "GPIO 38 (alternate per some third-party docs)"

        endchoice

        config HYDRO_STATUS_LED_BRIGHTNESS
            int "LED brightness (0-255)"
            range 1 255
            default 32
            depends on HYDRO_STATUS_LED_ENABLE
            help
                Scales every RGB channel before transmit (255 = full
                brightness). Default 32 (~12%) is dim enough for an
                always-on indicator sitting a few inches from the eye.

        config HYDRO_STATUS_LED_BLINK_MS
            int "Blink half-period (ms) for the degraded state"
            range 100 2000
            default 500
            depends on HYDRO_STATUS_LED_ENABLE
            help
                Half-period of the RED_BLINK presentation state (degraded /
                booting). The tick task polls at a fixed 100 ms granularity,
                and this value is converted to a tick count by integer
                division (value / 100) — a value that is not a multiple of
                100 silently rounds down to the nearest 100 ms, it does not
                round to the nearest or error out.

    endmenu

endmenu
